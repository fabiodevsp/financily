# App
APP_NAME=Financily
DEBUG=False

# Database (required) - postgresql+asyncpg://user:pass@host/db
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/financily

# Auth (required) - JWT signing key, 32+ random chars
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# OCR (Windows only) - path to tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
